<UserControl xmlns:controls="clr-namespace:SteamLuaManager.Controls" x:Class="SteamLuaManager.Views.ScriptDownloadView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- 榜单卡片模板：热门/推荐两排复用 -->
        <DataTemplate x:Key="RankCardTemplate">
            <controls:ClippingBorder Width="190" Margin="0,0,10,0" CornerRadius="10"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Cursor="Hand">
                <controls:ClippingBorder.Background>
                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                </controls:ClippingBorder.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Rectangle Grid.Row="0" Fill="{DynamicResource ControlFillColorDefaultBrush}"/>
                    <Image Grid.Row="0" Source="{Binding CoverUrl}" Stretch="UniformToFill"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           ImageFailed="SearchCover_ImageFailed"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                               Margin="12,10,12,2" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Grid Grid.Row="2" Margin="12,0,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DisplaySubtitle}" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1"
                                Command="{Binding DataContext.DownloadRankGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Height="26" Padding="8,2" FontSize="11"
                                IsEnabled="{Binding DataContext.IsDownloading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolInvertConverter}}">
                            <Button.Background>
                                <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                            </Button.Background>
                            <TextBlock Text="一键入库" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Grid>
            </controls:ClippingBorder>
        </DataTemplate>
    </UserControl.Resources>


    <controls:SmoothScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,24,36,24" HorizontalAlignment="Stretch">

            <!-- 页面标题 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="游戏入库" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
<TextBlock Margin="12,14,0,0" FontSize="12" FontWeight="Normal"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="-  当前清单接口 :"/>
                    <Run Text="{Binding CurrentDataSourceLabel, Mode=OneWay}"/>
                    <Run Text="{Binding LastUpdateTimeText, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
            <TextBlock Text="支持通过游戏AppID和游戏名搜索（中英文皆可），支持模糊匹配，最多显示10条搜索结果"
                       FontSize="12" Margin="0,0,0,2"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="如出现搜索不出结果可尝试开VPN或代理"
                       FontSize="12" Margin="0,0,0,2"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="如出现入库提示未收录，可尝试点击更新密钥缓存或设置里切换入库接口后重试；刚发售的新游戏清单可能同步不及时，可过一段时间再试"
                       FontSize="12" Margin="0,0,0,24"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <!-- 搜索卡片 -->
            <Border CornerRadius="10" Padding="16" Margin="0,0,0,8"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                </Border.Background>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:AutoSuggestBox x:Name="SearchBox" Grid.Column="0"
                                           PlaceholderText="输入游戏名或AppID"
                                           Padding="8,6" Margin="0,0,8,0" Height="36"
                                           VerticalContentAlignment="Center"
                                           FontSize="14" MinWidth="200"
                                           HorizontalAlignment="Stretch"
                                           QuerySubmitted="SearchBox_QuerySubmitted"
                                           TextChanged="SearchBox_TextChanged">
                            <ui:AutoSuggestBox.Background>
                                <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                            </ui:AutoSuggestBox.Background>
                            <ui:AutoSuggestBox.QueryIcon>
                                <ui:FontIcon Glyph="&#xE721;"/>
                            </ui:AutoSuggestBox.QueryIcon>
                        </ui:AutoSuggestBox>
                        <Button Grid.Column="1" Command="{Binding RefreshKeyCacheCommand}"
                                Padding="16,6" Height="36" FontSize="14" Margin="8,0,0,0"
                                Visibility="{Binding IsLocalCacheMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button.Background>
                                <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE72C;" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="更新密钥缓存" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding ClearLogCommand}"
                                Padding="16,6" Height="36" FontSize="14" Margin="8,0,0,0">
                            <Button.Background>
                                <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE74D;" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="清除日志" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                  Visibility="{Binding IsLocalCacheMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <CheckBox Content="DLC入库" IsChecked="{Binding IncludeDlc}"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  FontSize="13" Margin="0,0,32,0"
                                  ToolTip="勾选后，入库时将同时入库该游戏的全部DLC（仅本地缓存仓库模式生效）"/>
                        <CheckBox Content="固定游戏版本" IsChecked="{Binding PinManifest}"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  FontSize="13" Margin="0,0,32,0"
                                  ToolTip="勾选后，入库的游戏将固定到当前游戏最新版本，后续游戏更新也不会跟随触发更新，D加密游戏推荐勾选，以防止游戏更新导致D加密授权失效（仅本地缓存仓库模式生效）"/>
                        <CheckBox Content="获取名称注释" IsChecked="{Binding FetchNameComments}"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  FontSize="13"
                                  ToolTip="勾选后，入库时查询各游戏/仓库的中文名并写入注释；不勾选则只写ID，速度更快（仅本地缓存仓库模式生效）。仅推荐有代理/梯子的用户勾选，否则大概率会严重延长 Lua 生成时间"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 榜单区：无日志输出时展示，和日志区互斥 -->
            <StackPanel Visibility="{Binding IsRankingVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="0,0,0,8">
                <StackPanel Visibility="{Binding PopularRanking.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"
                            Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:FontIcon Glyph="&#xE734;" FontSize="16" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="热门榜单" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:ProgressRing IsActive="{Binding IsRankingLoading}" Width="16" Height="16"
                                         Margin="8,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsRankingLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"
                                  Padding="0,0,12,20">
                        <ItemsControl ItemsSource="{Binding PopularRanking}"
                                      ItemTemplate="{StaticResource RankCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
                <StackPanel Visibility="{Binding RecommendRanking.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:FontIcon Glyph="&#xE734;" FontSize="16" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="为你推荐" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"
                                  Padding="0,0,12,20">
                        <ItemsControl ItemsSource="{Binding RecommendRanking}"
                                      ItemTemplate="{StaticResource RankCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>

            <!-- 日志区域：榜单展示时隐藏 -->
            <Border CornerRadius="10" Padding="0"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,8"
                    Visibility="{Binding IsRankingVisible, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                </Border.Background>
                <Grid>
                    <TextBlock Text="暂无日志" Style="{StaticResource LogEmptyStyle}"
                               Visibility="{Binding LogLines.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                    <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Disabled" Margin="16,16,16,16"
                                  PreviewMouseWheel="LogScrollViewer_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding LogLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource LogTextStyle}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button x:Name="CopyLogButton" Content="复制日志"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,8,8,0" Padding="8,4" FontSize="12"
                            Click="CopyLogButton_Click" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- 搜索结果列表 -->
            <ItemsControl ItemsSource="{Binding SearchResults}" Margin="0,0,0,8"
                          Visibility="{Binding SearchResults.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="10" Padding="16" Margin="0,0,0,8"
                                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="120" Height="52"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,0,120,52" RadiusX="6" RadiusY="6"/>
                                    </Border.Clip>
                                    <Image Source="{Binding CoverUrl}" Stretch="UniformToFill"
                                           ImageFailed="SearchCover_ImageFailed"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DisplaySubtitle}" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Tag="{Binding}"
                                            Click="GameInfoButton_Click"
                                            Padding="16,6" Height="36" FontSize="14"
                                            Focusable="False" Margin="0,0,8,0">
                                        <Button.Background>
                                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                        </Button.Background>
                                        游戏信息
                                    </Button>
                                    <Button Command="{Binding DataContext.DownloadGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="16,6" Height="36" FontSize="14"
                                            Focusable="False"
                                            IsEnabled="{Binding DataContext.IsDownloading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolInvertConverter}}">
                                        <Button.Background>
                                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                        </Button.Background>
                                        一键入库
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- 搜过但无结果：给明确空提示，而不是只剩空白 -->
            <TextBlock Text="未找到匹配的游戏，换个关键词或直接用 AppID 搜索"
                       FontSize="13" HorizontalAlignment="Center" Margin="0,24,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding IsSearchEmptyVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

        </StackPanel>
    </controls:SmoothScrollViewer>
</UserControl>
